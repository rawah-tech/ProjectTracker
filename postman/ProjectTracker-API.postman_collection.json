{
  "info": {
    "_postman_id": "c9ce85d1-c67d-47c8-aca3-2b7c105ae93b",
    "name": "ProjectTracker API",
    "description": "Repeatable end-to-end workflow for the ProjectTracker API. Run the collection in order: it creates unique fictional credentials, captures the JWT and resource IDs, verifies each response, then deletes the task before deleting the project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Register') {",
          "  ['token', 'projectId', 'taskId', 'email', 'password'].forEach(function (key) {",
          "    pm.collectionVariables.unset(key);",
          "  });",
          "",
          "  const runId = pm.variables.replaceIn('{{$randomUUID}}');",
          "  pm.collectionVariables.set('email', `projecttracker.${runId}@example.test`);",
          "  pm.collectionVariables.set('password', `Demo-${runId}!A7`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5083",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Response contains a JWT', function () {",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.token.split('.')).to.have.lengthOf(3);",
              "});",
              "",
              "if (pm.response.code === 200 && body.token) {",
              "  pm.collectionVariables.set('token', body.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
