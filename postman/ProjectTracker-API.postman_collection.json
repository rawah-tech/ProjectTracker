              "const body = pm.response.json();",
              "pm.test('Created task has the expected fields', function () {",
              "  pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);",
              "  pm.expect(body.projectId).to.eql(pm.collectionVariables.get('projectId'));",
