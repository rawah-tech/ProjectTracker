        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Response is an array containing the created project', function () {",
              "  pm.expect(body).to.be.an('array');",
              "  const project = body.find(function (item) {",
              "    return item.id === pm.collectionVariables.get('projectId');",
              "  });",
              "  pm.expect(project).to.be.an('object');",
              "  pm.expect(project.name).to.eql('Portfolio project');",
              "});"
            ]
          }
        }
      ]
    },
