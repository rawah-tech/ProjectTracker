    {
      "name": "Create project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Portfolio project\",\n  \"description\": \"Created by the repeatable Postman workflow\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Created project has the expected fields', function () {",
              "  pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);",
              "  pm.expect(body.name).to.eql('Portfolio project');",
              "  pm.expect(body.description).to.eql('Created by the repeatable Postman workflow');",
              "});",
              "",
              "if (pm.response.code === 200 && body.id) {",
              "  pm.collectionVariables.set('projectId', body.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
