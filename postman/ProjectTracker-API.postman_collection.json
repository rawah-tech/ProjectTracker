              "  pm.expect(body.description).to.eql('Created by the repeatable Postman workflow');",
              "  pm.expect(new Date(body.dueDate).toISOString()).to.eql('2030-06-30T12:00:00.000Z');",
              "  pm.expect(body.isCompleted).to.be.false;",
              "});",
              "",
              "if (pm.response.code === 200 && body.id) {",
